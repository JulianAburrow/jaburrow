{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/images/*",
      "/_framework/*",
      "/_content/*"
    ]
  },
  "globalHeaders": {
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
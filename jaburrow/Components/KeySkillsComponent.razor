<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudCard Elevation="3" Class="p-6 mud-card">
        <MudText Typo="Typo.h4" GutterBottom="true">
            Key Skills
        </MudText>

        <MudList T="string">

            <MudListItem Icon="@Icons.Material.Filled.Circle">
                <MudText Typo="Typo.h5">.NET & Web Development</MudText>
                C#, ASP.NET Core, Blazor, MudBlazor, Razor, MVC, Entity Framework, LINQ, WebAPI
            </MudListItem>

            <MudListItem Icon="@Icons.Material.Filled.Circle">
                <MudText Typo="Typo.h5">Cloud & Infrastructure</MudText>
                Azure SQL Database, Azure Static Web Apps, AWS (Localstack), Docker, CI/CD (GitHub Actions, Jenkins)
            </MudListItem>

            <MudListItem Icon="@Icons.Material.Filled.Circle">
                <MudText Typo="Typo.h5">AI & Modern Development</MudText>
                RAG pipelines, LLM integration (Ollama), Natural-Language-to-SQL generation, Playwright testing
            </MudListItem>

            <MudListItem Icon="@Icons.Material.Filled.Circle">
                <MudText Typo="Typo.h5">Data & Storage</MudText>
                SQL Server, PostgreSQL, MySQL, Oracle, MariaDB, schema design, performance tuning, multi-database environments
            </MudListItem>

            <MudListItem Icon="@Icons.Material.Filled.Circle">
                <MudText Typo="Typo.h5">Tools, Testing & Collaboration</MudText>
                Teams, Slack, GitHub, GitHub Actions, Jenkins, Docker, DBeaver, PowerShell, xUnit
            </MudListItem>

        </MudList>
    </MudCard>

</MudContainer>
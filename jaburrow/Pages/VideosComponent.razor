@page "/videos"

<PageTitle>Videos – Julian Aburrow</PageTitle>

<HeadContent>
    <meta name="videos"
          content="Browse all videos by Julian Aburrow, including code and Mercedes Benz." />

    <meta property="og:title" content="Videos – Julian Aburrow" />
    <meta property="og:description"
          content="Access videos by Julian Aburrow." />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudCard Elevation="3" Class="p-6 mud-card">
        <MudText Typo="Typo.h3" GutterBottom="true">
            Videos
        </MudText>

        <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
            <MudTabPanel Text="Code" ToolTip="Code">

                <MudGrid GutterSize="3">
                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=Rf8g_zq50WM"
                                        Title="Speech To Text"
                                        Description="This is a short video demonstrating speech to text in my ManufacturerManager application." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=VYUhAu73tbY"
                                        Title="RAG AI Help"
                                        Description="This is a short video demonstrating RAG AI help in my ManufacturerManager application." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=o70PpIxl1zI"
                                        Title="Odds And Ends"
                                        Description="This is a short video demonstrating some coding solutions to interesting mathematical concepts." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=sb0x8ZG94JY"
                                        Title="Trigger A Webhook On GitHub Push Events"
                                        Description="This is a short video demonstrating pushing to GitHub and watching for push events to update my Azure Static Web App." />
                    </MudItem>
                </MudGrid>

            </MudTabPanel>

            <MudTabPanel Text="Mercedes Benz 300CE" ToolTip="Mercedes Benz 300CE">

                <MudGrid GutterSize="3">
                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=ISL-sHi7mk4"
                                        Title="Clara #1"
                                        Description="An introduction to my Mercedes W124 300CE daily driver." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=yZ6vbrmKDFk"
                                        Title="Clara #2"
                                        Description="Some more features of Clara, my Mercedes 300CE." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=F1mShEBuIHU"
                                        Title="Clara #3"
                                        Description="A few clips of driving in Clara." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=OsYkCkT-isg"
                                        Title="Clara #4"
                                        Description="Hasn't really been videoing weather and not much has been going on, so here's a few pictures from my first couple of years with Clara, my daily driver..." />
                    </MudItem>
                </MudGrid>

            </MudTabPanel>

            <MudTabPanel Text="Mercedes Benz 280CE" ToolTip="Mercedes Benz 280CE">

                <MudGrid GutterSize="3">
                    <MudItem xs="12" sm="6">
                        <VideoComponent Url="https://www.youtube.com/watch?v=SLXEH3QHcyk"
                                        Title="Bertha #1"
                                        Description="A wet day so I made a video about Bertha!" />
                    </MudItem>
                </MudGrid>

            </MudTabPanel>


        </MudTabs>
    </MudCard>
</MudContainer>



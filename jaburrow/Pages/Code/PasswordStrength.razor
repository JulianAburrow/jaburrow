@page "/passwordstrength"

<HeadContent>
    <meta name="description"
          content="Julian Aburrow's interactive password strength calculator demonstrating permutations based on selected criteria." />

    <meta property="og:title"
          content="Password Strength – Julian Aburrow" />

    <meta property="og:description"
          content="Explore password strength by selecting required character types and length. Interactive Blazor component calculates total permutations." />
</HeadContent>

<PageTitle>Password Strength</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudCard Elevation="3" Class="p-6">

        <MudText Typo="Typo.h4" GutterBottom="true">
            Password Strength
        </MudText>
        
        <MudText Typo="Typo.body1" GutterBottom="true">
            A quick look at how the strength of a password changes with different combinations of upper and lower case letters, and numbers.
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-4">
            Select the required characteristics of your password.
        </MudText>

        <MudStack Spacing="3">

            <MudItem>
                <MudText Typo="Typo.subtitle2">Require Lower Case</MudText>
                <MudCheckBox T="bool"
                             Disabled="true"
                             Checked="true"
                             @bind-Value="PasswordPropertiesSelected.RequireLowerCase" />
            </MudItem>

            <MudItem>
                <MudText Typo="Typo.subtitle2">Require Upper Case</MudText>
                <MudCheckBox T="bool"
                             @bind-Value="PasswordPropertiesSelected.RequireUpperCase"
                             @bind-Value:after="ShowPasswordCombinations" />
            </MudItem>

            <MudItem>
                <MudText Typo="Typo.subtitle2">Require Numbers</MudText>
                <MudCheckBox T="bool"
                             @bind-Value="PasswordPropertiesSelected.RequireNumbers"
                             @bind-Value:after="ShowPasswordCombinations" />
            </MudItem>

            <MudItem>
                <MudText Typo="Typo.subtitle2">Number of Characters</MudText>
                <MudSelect T="int"
                           @bind-Value="PasswordPropertiesSelected.NumberOfCharacters"
                           @bind-Value:after="ShowPasswordCombinations">
                    @foreach (var number in Numbers)
                    {
                        <MudSelectItem T="int" Value="@number">@number</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body1">
                There are
                <MudText Inline="true" Class="fw-bold" Color="Color.Primary">
                    @NumberOfPermutations
                </MudText>
                combinations possible with your selected criteria.
            </MudText>

        </MudStack>

    </MudCard>
</MudContainer>
